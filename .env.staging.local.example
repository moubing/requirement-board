# Copy the server-generated client profile to .env.staging.local instead of
# putting real passwords or MinIO credentials in this tracked example.
DATABASE_PROFILE=staging
DATABASE_URL=postgres://rb_staging_debug:<staging-debug-password>@127.0.0.1:15439/requirement_board_staging
ASSET_STORAGE_DRIVER=s3
ASSET_GC_GRACE_HOURS=168
S3_ENDPOINT=http://192.0.2.20:9000
S3_REGION=us-east-1
S3_BUCKET=requirement-board-files-staging
S3_ACCESS_KEY_ID=<staging-access-key-id>
S3_SECRET_ACCESS_KEY=<staging-secret-access-key>
S3_FORCE_PATH_STYLE=true
