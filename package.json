{
  "name": "requirement-board",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "ui:check": "node scripts/check-ui-workspace.mjs",
    "dev": "nuxt dev",
    "dev:staging": "node scripts/run-database-profile.mjs staging dev",
    "build": "nuxt build",
    "build:deploy": "pnpm build && esbuild deploy/migrate.ts --bundle --platform=node --format=esm --outfile=.output/tools/migrate.mjs && esbuild server/db/seed.ts --bundle --platform=node --format=esm --outfile=.output/tools/seed.mjs && esbuild server/scripts/set-user-password.ts --bundle --platform=node --format=esm --outfile=.output/tools/set-user-password.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "db:check:migrations": "node scripts/check-migrations.mjs",
    "db:tunnel": "ssh -N -T -o BatchMode=yes -o ConnectTimeout=10 -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:15439:127.0.0.1:5439 board-server",
    "db:check:staging": "node scripts/run-database-profile.mjs staging check",
    "db:check:prod:readonly": "node scripts/run-database-profile.mjs production-readonly check",
    "db:migrate": "node scripts/check-migrations.mjs && tsx server/scripts/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:reset": "tsx server/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "auth:set-password": "tsx server/scripts/set-user-password.ts",
    "assets:gc": "tsx server/scripts/gc-assets.ts",
    "assets:gc:dry": "tsx server/scripts/gc-assets.ts --dry-run",
    "test": "vitest run",
    "test:auth": "vitest run tests/auth",
    "test:unit": "vitest run tests/diff",
    "test:api": "vitest run tests/api",
    "test:browser": "tsx tests/browser/quick-switch.ts",
    "test:browser:documents": "tsx tests/browser/documents.ts",
    "test:browser:agent": "tsx tests/browser/agent-suggestions.ts",
    "test:browser:editor": "node tests/browser/editor-history-clipboard.mjs",
    "test:browser:workspace": "node tests/browser/requirement-workspace.mjs",
    "test:browser:auth": "tsx tests/browser/auth-navigation.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@better-auth/drizzle-adapter": "1.7.1",
    "@hocuspocus/provider": "4.6.0",
    "@hocuspocus/server": "4.6.0",
    "@moubing/bing-ui": "0.19.0",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-blockquote": "^3.27.3",
    "@tiptap/extension-bullet-list": "^3.27.3",
    "@tiptap/extension-code-block": "^3.27.3",
    "@tiptap/extension-collaboration": "3.27.3",
    "@tiptap/extension-collaboration-caret": "3.27.3",
    "@tiptap/extension-details": "3.27.3",
    "@tiptap/extension-document": "^3.27.3",
    "@tiptap/extension-heading": "^3.27.3",
    "@tiptap/extension-highlight": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-list": "3.27.3",
    "@tiptap/extension-list-item": "^3.27.3",
    "@tiptap/extension-ordered-list": "^3.27.3",
    "@tiptap/extension-paragraph": "^3.27.3",
    "@tiptap/extension-table": "^3.27.3",
    "@tiptap/extension-text": "^3.27.3",
    "@tiptap/extension-typography": "^3.27.3",
    "@tiptap/markdown": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@tiptap/vue-3": "^3.27.3",
    "@tiptap/y-tiptap": "3.0.9",
    "better-auth": "1.7.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lucide-vue-next": "^1.0.0",
    "nanoid": "^5.1.6",
    "nuxt": "^4.4.8",
    "postgres": "^3.4.7",
    "sharp": "0.35.5",
    "vue": "^3.5.38",
    "y-protocols": "1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "1.60.0",
    "@types/node": "^24.12.3",
    "@vue/test-utils": "^2.4.10",
    "drizzle-kit": "^0.31.8",
    "esbuild": "0.28.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.2.8"
  }
}
