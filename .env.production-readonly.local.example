# Copy the server-generated client profile to .env.production-readonly.local.
# This profile is for connection checks and SQL clients; Better Auth requires
# session writes, so it cannot run a local Nuxt instance. Production
# object-storage credentials are intentionally not distributed.
DATABASE_PROFILE=production-readonly
DATABASE_URL=postgres://rb_prod_readonly:<production-readonly-password>@127.0.0.1:15439/requirement_board_prod
ASSET_STORAGE_DRIVER=local
ASSET_UPLOAD_DIR=.local-data/production-readonly-uploads
ASSET_GC_GRACE_HOURS=168
