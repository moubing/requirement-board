# 本地开发默认配置；远程数据库使用忽略的 .env.staging.local 和 .env.production-readonly.local。
DATABASE_URL=postgres://requirement:requirement@localhost:5438/requirement_board
TEST_DATABASE_URL=postgres://requirement:requirement@localhost:5438/requirement_board_test
BETTER_AUTH_SECRET=requirement-board-local-development-secret
# pnpm dev 使用回环地址时，下列三项由实际监听端口和 worktree 自动生成，不改写本文件。
# 打包部署或使用自定义域名时仍须显式配置准确来源和 Cookie 前缀。
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000
BETTER_AUTH_COOKIE_PREFIX=rb-local
ASSET_STORAGE_DRIVER=local
ASSET_UPLOAD_DIR=.local-data/uploads
ASSET_GC_GRACE_HOURS=168
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=requirement-board-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# 游客页的项目源码入口，可按需覆盖默认仓库地址。
NUXT_PUBLIC_DEMO_SOURCE_URL=https://github.com/moubing/requirement-board

# Optional configuration on the user's LOCAL AI AGENT process only.
# These are not server runtime settings; do not put a real PAT in a shared .env file.
# RB_BASE_URL=https://your-board.example.com
# RB_TOKEN=<create a personal credential on the account page>
